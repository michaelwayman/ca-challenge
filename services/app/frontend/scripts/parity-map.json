{
  "comment": "Maps every selector in reference/theme.css (the compiled WP theme) to the selectors that replace it in scss/. 'alias' renames a property or token that moved. 'skip' lists rules intentionally not built yet, with the reason.",
  "map": {
    ":root": {
      "to": [":root"],
      "alias": {
        "--color-card": "--color-surface",
        "--radius": "--radius-md",
        "--shadow": "--shadow-md"
      }
    },
    "*": ["*"],
    "html": ["html", "body"],
    "body": ["html", "body"],
    "a": ["a"],
    "a:hover": ["a:hover"],
    "img": ["img"],
    ".container": [".container"],
    ".site-header": [".site-header"],
    ".site-header .container": [".site-header__inner"],
    ".site-title": [".site-header__title"],
    ".site-title a": [".site-header__link"],
    ".hero": [".hero"],
    ".hero h1": [".hero__title"],
    ".hero p": [".hero__lede"],
    ".section": [".section"],
    ".section h2": [".section__title"],
    ".grid": [".grid"],
    ".card": [".card"],
    ".card:hover": [".card:hover"],
    ".card h3": [".card__title"],
    ".card h3 a": [".card__link"],
    ".card .meta": [".card__meta"],
    ".card .excerpt": [".card__excerpt"],
    ".stars": [".stars"],
    ".stars .star-full": [".stars__star--full"],
    ".stars .star-empty": [".stars__star--empty"],
    ".stars .rating-value": [".stars__value"],
    ".badge": [".badge"],
    ".brand-hero": [".hero--plain"],
    ".brand-hero h1": [".hero__title"],
    ".brand-hero .brand-meta": [".facts"],
    ".brand-hero .brand-meta strong": [".facts__label"],
    ".brand-body": [".section"],
    ".brand-body .content": [".surface", ".prose"],
    ".reviews-section": [".section"],
    ".reviews-section h2": [".section__title"],
    ".review-item": [".review"],
    ".review-item .review-head": [".review__header"],
    ".review-item h3": [".review__title"],
    ".review-item h3 a": [".review__link"],
    ".review-item .review-byline": [".review__byline"],
    ".review-item .review-body": [".review__body", ".prose"],
    ".review-hero": [".hero--plain"],
    ".review-hero .brand-link": [".hero__backlink", "a"],
    ".review-hero h1": [".hero__title"],
    ".site-footer": [".site-footer"],
    ".page-body": {
      "to": [".surface", ".section"],
      "alias": {
        "margin": "padding"
      }
    },
    ".page-body h1": [".surface__title"],
    "@media (max-width: 640px) .hero": ["@media (max-width: 640px) .hero"],
    "@media (max-width: 640px) .hero h1": {
      "to": ["@media (max-width: 640px) .hero"],
      "alias": {
        "font-size": "--hero-title-size"
      }
    },
    "@media (max-width: 640px) .site-header .container": [
      "@media (max-width: 640px) .site-header__inner"
    ],
    "@media (max-width: 640px) .grid": ["@media (max-width: 640px) .grid"],
    ".site-nav": [".site-nav"],
    ".site-nav a": [".site-nav__link"],
    ".site-nav a:hover": [".site-nav__link:hover"],
    ".section-header": [".section__header"],
    ".section-header h2": [".section__title"],
    ".section-header a": [".section__link"],
    ".pagination": [".pagination"],
    ".pagination .page-numbers": [".pagination__link"],
    ".pagination .page-numbers.current": [".pagination__link--current"]
  },
  "skip": {
    ".site-footer a": "the footer has no links"
  }
}
