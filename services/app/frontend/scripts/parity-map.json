{
  "comment": "Maps every selector in reference/theme.css (the compiled WP theme) to the selectors that replace it in scss/. Most are the same selector: the SCSS uses the reference's names and nesting. 'alias' renames a property or token that moved. 'skip' lists rules intentionally not built, with the reason.",
  "map": {
    ":root": {
      "to": [":root"],
      "alias": {
        "--color-card": "--color-surface",
        "--radius": "--radius-md",
        "--shadow": "--shadow-md"
      }
    },
    "*": ["*"],
    "html": ["html", "body"],
    "body": ["html", "body"],
    "a": ["a"],
    "a:hover": ["a:hover"],
    "img": ["img"],
    ".container": [".container"],
    ".site-header": [".site-header"],
    ".site-header .container": [".site-header .container"],
    ".site-title": [".site-title"],
    ".site-title a": [".site-title a"],
    ".hero": [".hero"],
    ".hero h1": [".hero h1"],
    ".hero p": [".hero p"],
    ".section": [".section"],
    ".section h2": [".section-header h2"],
    ".grid": [".grid"],
    ".card": [".card"],
    ".card:hover": [".card:hover"],
    ".card h3": [".card h3"],
    ".card h3 a": [".card h3 a"],
    ".card .meta": [".card .meta"],
    ".card .excerpt": [".card .excerpt"],
    ".stars": [".stars"],
    ".stars .star-full": [".stars .star-full"],
    ".stars .star-empty": [".stars .star-empty"],
    ".stars .rating-value": [".stars .rating-value"],
    ".badge": [".badge"],
    ".brand-hero": [".brand-hero"],
    ".brand-hero h1": [".brand-hero h1"],
    ".brand-hero .brand-meta": [".brand-meta"],
    ".brand-hero .brand-meta strong": [".brand-meta dt"],
    ".brand-body": [".section"],
    ".brand-body .content": [".brand-body .content", ".prose"],
    ".reviews-section": [".section"],
    ".reviews-section h2": [".section-header h2"],
    ".review-item": [".review-item"],
    ".review-item .review-head": [".review-item .review-head"],
    ".review-item h3": [".review-item h3"],
    ".review-item h3 a": [".review-item h3 a"],
    ".review-item .review-byline": [".review-byline"],
    ".review-item .review-body": [".review-item .review-body", ".prose"],
    ".review-hero": [".review-hero"],
    ".review-hero .brand-link": [".review-hero .brand-link", "a"],
    ".review-hero h1": [".review-hero h1"],
    ".site-footer": [".site-footer"],
    ".page-body": {
      "to": [".surface", ".section"],
      "alias": {
        "margin": "padding"
      }
    },
    ".page-body h1": [".surface h1"],
    "@media (max-width: 640px) .hero": ["@media (max-width: 640px) .hero"],
    "@media (max-width: 640px) .hero h1": ["@media (max-width: 640px) .hero h1"],
    "@media (max-width: 640px) .site-header .container": [
      "@media (max-width: 640px) .site-header .container"
    ],
    "@media (max-width: 640px) .grid": ["@media (max-width: 640px) .grid"],
    ".site-nav": [".site-nav"],
    ".site-nav a": [".site-nav a"],
    ".site-nav a:hover": [".site-nav a:hover"],
    ".section-header": [".section-header"],
    ".section-header h2": [".section-header h2"],
    ".section-header a": [".section-header a"],
    ".pagination": [".pagination"],
    ".pagination .page-numbers": [".pagination .page-numbers"],
    ".pagination .page-numbers.current": [".pagination .page-numbers.current"]
  },
  "skip": {
    ".site-footer a": "the footer has no links"
  }
}
