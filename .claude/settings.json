{
  "permissions": {
    "ask": [
      "Edit(**/pyproject.toml)",
      "Edit(**/package.json)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv pip install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(npm install *)",
      "Edit(services/app/catalog/api/**)"
    ],
    "deny": [
      "Edit(CHALLENGE.md)",
      "Edit(data/**)",
      "Edit(uv.lock)",
      "Edit(**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-checks.sh",
            "timeout": 300,
            "statusMessage": "Lint and migration checks before commit"
          }
        ]
      }
    ]
  }
}
