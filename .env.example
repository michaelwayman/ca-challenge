# Copy to .env. Defaults in docker-compose.yml match these values.
APP_DB_NAME=app
APP_DB_USER=app
APP_DB_PASSWORD=app
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth

# Shared by the auth service and the main app (introspection). Dev default; change elsewhere.
AUTH_SERVICE_SECRET=dev-service-secret

# WordPress source DB (profile `migration-source`), seeded from data/wordpress-dump.sql
WP_DB_NAME=wp
WP_DB_USER=wp
WP_DB_PASSWORD=wp
WP_TABLE_PREFIX=wp_
